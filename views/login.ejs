<%- include("partials/header", { title }) %>
<section class="auth-wrap container py-5">
  <div class="auth-card">
    <p class="eyebrow">WELCOME BACK</p>
    <h1 class="h2 fw-bold">Sign in</h1>
    <p class="text-secondary">Continue building your portfolio.</p>
    <% if (errors.length) { %><div class="alert alert-danger" role="alert"><ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
    <form action="/auth/login" method="post" class="vstack gap-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" required maxlength="254" value="<%= values.email || '' %>"></div>
      <div><label class="form-label" for="password">Password</label><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required></div>
      <button class="btn btn-primary btn-lg mt-2" type="submit">Sign in</button>
    </form>
    <p class="small text-secondary mt-4 mb-0">New here? <a href="/register">Create an account</a></p>
  </div>
</section>
<%- include("partials/footer") %>
