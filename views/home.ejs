<%- include("partials/header", { title }) %>
<section class="hero-section">
  <div class="container py-5 py-lg-6">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <p class="eyebrow">FULL STACK DEVELOPMENT · INTERNSHIP PROJECT</p>
        <h1 class="display-4 fw-bold">Turn your learning into a <span class="text-gradient">working portfolio.</span></h1>
        <p class="lead text-secondary mt-4">Plan projects, track progress, and demonstrate the full-stack skills you build along the way.</p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a class="btn btn-primary btn-lg" href="/register">Create your portfolio</a>
          <a class="btn btn-outline-secondary btn-lg" href="#features">Explore features</a>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="preview-card">
          <div class="d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Project snapshot</span>
            <span class="status-pill status-in-progress">In progress</span>
          </div>
          <div class="preview-line mt-4"></div>
          <div class="preview-line short"></div>
          <div class="d-flex gap-2 mt-4">
            <span class="mini-tag">Express</span><span class="mini-tag">SQLite</span><span class="mini-tag">JavaScript</span>
          </div>
          <div class="progress mt-4" role="progressbar" aria-label="Sample project progress" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar sample-progress"></div>
          </div>
          <p class="small text-secondary mt-2 mb-0">A responsive dashboard backed by your own API</p>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="container py-5" id="features">
  <div class="text-center mb-5">
    <p class="eyebrow">LEARN BY BUILDING</p>
    <h2 class="fw-bold">One project. Full-stack skills.</h2>
    <p class="text-secondary">An original practice app mapped to your internship task levels.</p>
  </div>
  <div class="row g-4">
    <div class="col-md-4"><article class="feature-card"><span class="feature-number">01</span><h3>Track projects</h3><p>Create, update, and organize your work with a simple dashboard.</p></article></div>
    <div class="col-md-4"><article class="feature-card"><span class="feature-number">02</span><h3>Build securely</h3><p>Practice validated forms, password hashing, sessions, and protected APIs.</p></article></div>
    <div class="col-md-4"><article class="feature-card"><span class="feature-number">03</span><h3>Connect services</h3><p>Explore an external weather API, request limits, caching, and background jobs.</p></article></div>
  </div>
</section>
<%- include("partials/footer") %>
