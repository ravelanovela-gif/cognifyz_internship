<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> | Cognifyz Internship Showcase</title>
  <style nonce="<%= cspNonce %>">.sample-progress{width:65%}</style>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <header class="site-header">
    <nav class="navbar navbar-expand-lg container py-3" aria-label="Main navigation">
      <a class="navbar-brand fw-bold" href="/">Cognifyz<span class="brand-dot">.</span></a>
      <div class="ms-auto d-flex align-items-center gap-2">
        <% if (user) { %>
          <span class="small text-secondary d-none d-sm-inline">Hi, <%= user.name %></span>
          <a class="btn btn-sm btn-outline-primary" href="/dashboard">Dashboard</a>
          <form action="/auth/logout" method="post" class="d-inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-dark" type="submit">Sign out</button>
          </form>
        <% } else { %>
          <a class="btn btn-sm btn-outline-primary" href="/login">Sign in</a>
          <a class="btn btn-sm btn-primary" href="/register">Create account</a>
        <% } %>
      </div>
    </nav>
  </header>
  <main>
